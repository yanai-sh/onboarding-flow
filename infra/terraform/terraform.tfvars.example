# Copy to terraform.tfvars (gitignored) and set project_id.
# The image tag is not stored here; pass it per deploy:
#   terraform apply -var image_tag=$(git rev-parse --short HEAD)

project_id = "your-gcp-project-id"
region     = "us-central1"

# Cost guardrail for the demo (scale-to-zero stays on).
max_instances = 1
